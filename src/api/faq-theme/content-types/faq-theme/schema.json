{
  "kind": "collectionType",
  "collectionName": "faq_theme_entries",
  "info": {
    "singularName": "faq-theme",
    "pluralName": "faq-themes",
    "displayName": "Thèmes de FAQ",
    "description": "Regroupement des questions fréquentes par sujet, utilisé sur la page Candidature."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "faq_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::faq-item.faq-item",
      "mappedBy": "faq_theme"
    }
  }
}
