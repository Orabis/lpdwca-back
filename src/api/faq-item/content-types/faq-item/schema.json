{
  "kind": "collectionType",
  "collectionName": "faq_item_entries",
  "info": {
    "singularName": "faq-item",
    "pluralName": "faq-items",
    "displayName": "Questions fréquentes",
    "description": "Une question et sa réponse. Cocher « Afficher sur l'accueil » pour la faire remonter sur la page d'accueil."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "text",
      "required": true
    },
    "faq_theme": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::faq-theme.faq-theme",
      "inversedBy": "faq_items"
    },
    "showOnHome": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
